# Copy to `.env.local`. `.env.local` is gitignored; this file is not.
#
# These are the SDK's own variable names, so `ElanClient` and the CLI agree
# about them (elan-sdk exports them as ENV_URL, ENV_PROJECT, ENV_CLIENT_ID,
# ENV_CLIENT_SECRET).

ELAN_API_URL=https://api.openelan.ai
ELAN_PROJECT=agents

# A SERVICE USER, created in the console's API access page or with
# POST /v1/projects/{project}/service-users. THE SECRET NEVER REACHES THE
# BROWSER — it is read only inside app/api/*, which runs on the server.
ELAN_CLIENT_ID=
ELAN_CLIENT_SECRET=

# Which agent this chat talks to.
ELAN_TARGET=invoice-triage

# Signs the demo identity cookie. Any long random string; `openssl rand -hex 32`.
DEMO_SESSION_SECRET=

# OPTIONAL, AND THE ONE YOU WANT IF YOU HAVE OPENED A WALLET. A wallet is keyed
# on the external user id, so the generated `demo-<random>` id can never match
# one you created — the lookup resolves nothing and the run falls back to the
# tenant's token balance. Set this to the id you opened a wallet for
# (`elan wallet new demo-wallet`) and every run here is funded by it.
#
# A server variable, never a request field, so a visitor cannot point the app
# at somebody else's wallet.
DEMO_USER_ID=
